# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# DeepSeek generation model
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_TEMPERATURE=0
DEEPSEEK_API_KEY=

# Local BGE embeddings and persistent Qdrant
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
MODEL_CACHE_PATH=./.cache/huggingface
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=agenthub_knowledge
RAG_TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# Conversation memory
MEMORY_BACKEND=redis
REDIS_URL=redis://localhost:6379/0
MEMORY_TTL_SECONDS=604800
MEMORY_FALLBACK_TO_LOCAL=true

# Optional MCP stdio server
MCP_SERVER_COMMAND=
MCP_SERVER_ARGS=[]

